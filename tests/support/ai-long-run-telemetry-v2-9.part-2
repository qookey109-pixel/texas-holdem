        vpip: false,
        pfr: false,
        foldStreet: "",
        threeBetOpportunityRecorded: false,
        foldToThreeBetOpportunity: false,
        foldToThreeBetResolved: false,
      });
      startingWealth.set(player.name, (Number(player.stack) || 0) + (Number(player.totalContribution) || 0));
    }
    return {
      handNumber: Number(state?.handNumber) || 0,
      bigBlind,
      heroProfile,
      flags,
      startingWealth,
      preflopRaiseCount: 0,
      opener: "",
      preflopAggressor: "",
      cbetActor: "",
      cbetOpportunityRecorded: false,
      cbetResponses: new Set(),
      streetAggressions: Object.fromEntries(STREETS.map(street => [street, 0])),
      checked: Object.fromEntries(STREETS.map(street => [street, new Set()])),
      checkRaiseFacing: Object.fromEntries(STREETS.map(street => [street, new Set()])),
    };
  }

  function createVirtualScheduler(startTime) {
    let virtualNow = startTime;
    let nextTimerId = 1;
    let nextSequence = 1;
    const timers = new Map();
    const errors = [];

    function schedule(type, callback, delay, args) {
      const id = nextTimerId++;
      const duration = Math.max(0, Number(delay) || 0);
      timers.set(id, {
        id,
        type,
        callback,
        args,
        delay: duration,
        due: virtualNow + duration,
        sequence: nextSequence++,
        label: String(callback?.name || "anonymous"),
      });
      return id;
    }

    function clear(id) {
      timers.delete(Number(id));
    }

    function next() {
      let selected = null;
      for (const timer of timers.values()) {
        if (!selected || timer.due < selected.due || (timer.due === selected.due && timer.sequence < selected.sequence)) selected = timer;
      }
      return selected;
    }

    function runNext() {
      const timer = next();
      if (!timer) return null;
      timers.delete(timer.id);
      virtualNow = Math.max(virtualNow, timer.due);
      if (timer.type === "interval") {
        timer.due = virtualNow + Math.max(1, timer.delay);
        timer.sequence = nextSequence++;
        timers.set(timer.id, timer);
      }
      try {
        if (typeof timer.callback === "function") timer.callback(...timer.args);
      } catch (error) {
        errors.push(`${timer.label}: ${error?.stack || error}`);
      }
      return timer;
    }

    function details() {
      return [...timers.values()]
        .sort((left, right) => left.due - right.due || left.sequence - right.sequence)
        .slice(0, 30)
        .map(timer => ({ type: timer.type, label: timer.label, dueIn: timer.due - virtualNow }));
    }

    return {
      errors,
      schedule,
      clear,
      runNext,
      details,
      size: () => timers.size,
      clearAll: () => timers.clear(),
      now: () => virtualNow,
    };
  }

  function chooseHeroAction(profile, decisionIndex, random) {
    const player = human();
    const needed = Math.max(0, amountToCall(player));
    const pot = Math.max(1, Number(state?.pot) || 1);
    const bigBlind = Math.max(1, currentBigBlind());
    const availableRaise = Math.max(0, Number(player?.stack) - needed);
    const minimumRaise = Math.max(bigBlind, minimumRaiseBy());
    const canRaise = !player?.raiseLocked && availableRaise >= minimumRaise;
    const strength = clamp(estimateStrength(player), 0.01, 0.99);
    const potOdds = needed / Math.max(1, pot + needed);
    const stackBb = Number(player?.stack) / bigBlind;
    const roll = random();
    const free = needed === 0;
    let action = "call";
    let raiseFraction = 0.55;

    if (profile === "tight") {
      if (!free && strength < potOdds + 0.105) action = "fold";
      else if (canRaise && strength >= 0.76) { action = "raise"; raiseFraction = 0.62; }
      else if (canRaise && free && strength >= 0.66 && roll < 0.24) { action = "raise"; raiseFraction = 0.46; }
    } else if (profile === "balanced") {
      if (!free && strength < potOdds + 0.018 && roll < 0.78) action = "fold";
      else if (canRaise && (strength >= 0.66 || (free && strength >= 0.48 && roll < 0.14))) {
        action = "raise";
        raiseFraction = state.board.length >= 3 ? (strength >= 0.72 ? 0.72 : 0.42) : 0.58;
      }
    } else if (profile === "loose-aggressive") {
      if (!free && strength < potOdds - 0.055 && roll < 0.42) action = "fold";
      else if (canRaise && (strength >= 0.49 || roll < 0.24)) {
        action = "raise";
        raiseFraction = roll < 0.28 ? 0.95 : 0.62;
      }
    } else if (profile === "calling") {
      if (!free && strength < potOdds - 0.11 && roll < 0.55) action = "fold";
      else if (canRaise && strength >= 0.84 && roll < 0.55) {
        action = "raise";
        raiseFraction = 0.68;
      }
    } else {
      const pressureBeat = decisionIndex % 6;
      if (!free && strength < potOdds - 0.025 && pressureBeat === 4) action = "fold";
      else if (canRaise && (strength >= 0.58 || pressureBeat === 0 || (free && roll < 0.2))) {
        action = "raise";
        raiseFraction = pressureBeat === 0 ? 0.82 : 0.5;
      }
    }

    if (stackBb <= 9 && strength >= 0.68 && player.stack > 0 && (!player.raiseLocked || player.stack <= needed)) action = "allin";

    if (action === "raise") {
      const desired = Math.max(minimumRaise, Math.round((pot * raiseFraction) / 10) * 10);
      els.raiseAmount.value = String(Math.min(availableRaise, desired));
    }
    playerAction(action);
    return action;
  }

  function validateState(expectedChips) {
    const players = state.players || [];
    const allCards = [...(state.deck || []), ...(state.board || []), ...players.flatMap(player => player.cards || [])];
    const cardKey = card => `${card?.rank ?? card?.label ?? card?.value}-${card?.suit}`;
    const totalChips = players.reduce((sum, player) => sum + (Number(player.stack) || 0), 0) + (Number(state.pot) || 0);
    const contributionTotal = players.reduce((sum, player) => sum + (Number(player.totalContribution) || 0), 0);
    const maximumBet = Math.max(0, ...players.map(player => Number(player.bet) || 0));
    const errors = [];

    if (players.length !== TABLE_AI_COUNT + 1) errors.push(`player-count:${players.length}/${TABLE_AI_COUNT + 1}`);
    if (allCards.length !== 52) errors.push(`card-count:${allCards.length}`);
    if (new Set(allCards.map(cardKey)).size !== allCards.length) errors.push("duplicate-card");
    if (![0, 3, 4, 5].includes(state.board.length)) errors.push(`board:${state.board.length}`);
    if (!Number.isInteger(state.pot) || state.pot < 0) errors.push(`pot:${state.pot}`);
    if (totalChips !== expectedChips) errors.push(`chips:${totalChips}/${expectedChips}`);
    if (!state.handOver && contributionTotal !== state.pot) errors.push(`contributions:${contributionTotal}/${state.pot}`);
    if (!state.handOver && state.currentBet !== maximumBet) errors.push(`current-bet:${state.currentBet}/${maximumBet}`);
    if (state.currentActorIndex < -1 || state.currentActorIndex >= players.length) errors.push(`actor:${state.currentActorIndex}`);
    if (state.waitingForHuman && state.currentActorIndex !== 0) errors.push(`human-wait-actor:${state.currentActorIndex}`);

    for (const player of players) {
      for (const [field, value] of [["stack", player.stack], ["bet", player.bet], ["totalContribution", player.totalContribution]]) {
        if (!Number.isInteger(value) || value < 0) errors.push(`${player.name}:${field}:${value}`);
      }
    }
    return { errors, totalChips };
  }

  function publicFairnessSnapshot() {
    const policy = window.AiTierStrategyV28?.fairInformationPolicy || {};
    const bossPolicy = window.FairSpecialBosses?.fairInformationPolicy || {};
    const omniscient = LOCAL_NAMES.filter(name => Boolean(AI_ROSTER.find(candidate => candidate?.name === name)?.omniscient));
    return {
      ownCards: policy.ownHoleCards !== false,
      publicBoard: policy.publicBoard !== false,
      publicActions: policy.publicActions !== false,
      hiddenOpponentCards: policy.hiddenOpponentCards === true || bossPolicy.hiddenOpponentCards === true,
      actualDeckOrder: policy.actualDeckOrder === true || bossPolicy.actualDeckOrder === true,
      futureBoardAnswer: policy.futureBoardAnswer === true || bossPolicy.futureBoardAnswer === true,
      predeterminedWinner: policy.predeterminedWinner === true || bossPolicy.predeterminedWinner === true,
      omniscientProfiles: omniscient,
      publicInformationOnly: omniscient.length === 0
        && policy.hiddenOpponentCards !== true
        && policy.actualDeckOrder !== true
        && policy.futureBoardAnswer !== true
        && policy.predeterminedWinner !== true,
    };
  }

  function runShard(options = {}) {
    const requestedHands = Number.parseInt(options.hands ?? 100, 10);
    const hands = Number.isInteger(requestedHands)
      ? Math.min(MAX_HANDS_PER_SHARD, Math.max(1, requestedHands))
